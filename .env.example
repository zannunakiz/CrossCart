# ────────────────────────────────────────────────────────────────────────────
# POSTGRES (NEONDB)
# ────────────────────────────────────────────────────────────────────────────
DATABASE_URI=

# ────────────────────────────────────────────────────────────────────────────
# NEXTAUTH
# ────────────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# ────────────────────────────────────────────────────────────────────────────
# GOOGLE OAUTH
# ────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ────────────────────────────────────────────────────────────────────────────
# CLOUDINARY  (https://console.cloudinary.com → Settings → API Keys)
# NEXT_PUBLIC_ prefix makes cloud_name available in the browser for CldImage.
# API key + secret are SERVER-SIDE ONLY (never expose to client).
# Uploads are SIGNED (the `uploadStoreQr` Server Action uploads with the API
# secret), so no unsigned upload preset is required.
# ────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Open Router
# OPEN_ROUTER_KEY  — API key used by the voice-order Server Action
#                    (`interpretVoiceOrder`).
# OPEN_ROUTER_MODEL — optional; defaults to the zero-cost "openrouter/free" router.
OPEN_ROUTER_KEY=
OPEN_ROUTER_MODEL=openrouter/free


# ────────────────────────────────────────────────────────────────────────────
# API EXPOSURE / SECURITY
# This app exposes NO public API of its own: `/api/auth/**` (NextAuth) is the
# only route handler left, and every data operation is a Server Action under
# `lib/actions/**`. A Server Action still answers a plain POST, so it is not
# "hidden" — what protects the data is the session check INSIDE each action
# (`currentSession()` → `getUserRole()` → `hasPermission()`), which answers
# `{ ok: false, error: "Unauthorized", status: 401 }` when the request carries
# no valid session cookie. Never move data access into a Client Component, and
# never add an action that skips those three checks.
# ────────────────────────────────────────────────────────────────────────────


# Sentry
SENTRY_AUTH_TOKEN=